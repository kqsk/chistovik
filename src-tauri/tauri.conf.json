{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Чистовик",
  "version": "0.1.0",
  "identifier": "app.chistovik",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    },
    "publisher": "kqsk",
    "shortDescription": "Чистовик — работа с текстом через нейросеть в любом приложении"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2NkUzODcyMUQ1QjkwRTkKUldUcGtGc2Rjamh1UmlMKzVlbWk4eUdHK1hOdElDVGxJQ2FlbTRGYlhSdmdrS0laTzlVNDczY1YK",
      "endpoints": [
        "https://github.com/kqsk/chistovik/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
